{
  "name": "x-post-screenshot",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Userscript for saving X/Twitter posts as images.",
  "license": "MIT",
  "author": "PYUDNG",
  "repository": {
    "type": "git",
    "url": "https://github.com/PYUDNG/x-post-screenshot.git"
  },
  "homepage": "https://github.com/PYUDNG/x-post-screenshot#readme",
  "bugs": {
    "url": "https://github.com/PYUDNG/x-post-screenshot/issues"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && pnpm build:github && pnpm build:greasyfork && node scripts/verify-build.mjs",
    "build:github": "vite build --mode github",
    "build:greasyfork": "vite build --mode greasyfork",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:build": "node scripts/verify-build.mjs",
    "release:check": "node scripts/check-release.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:browser && pnpm build"
  },
  "dependencies": {
    "html-to-image": "1.11.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-monkey": "8.1.1",
    "vitest": "5.0.5"
  }
}
